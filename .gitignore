# Local datasets (including downloaded train/test Parquet files)
*.parquet
/data/raw/

# Downloaded submission bundles and other large archives
*.zip
*.7z
*.rar

# Locally trained model artifacts / checkpoints
*.joblib
*.pkl
*.pickle
*.model
*.pt
*.pth
*.onnx
*.h5
*.hdf5

# Reference papers, generated figures, and report source/build files
/paper/
/latex/

# Generated outputs
/output/
/outputs/

# Python cache files
__pycache__/
*.py[cod]

# Portable local compiler used by the LaTeX Workshop Tectonic recipe
/.tools/
/tmp/

# Presentation source and final deck are versioned; local render caches are not.
/ppt/~$*.pptx
/ppt/fraud_detection_*/backup/
/ppt/fraud_detection_*/exports/
/ppt/fraud_detection_*/validation/
/ppt/fraud_detection_*/live_preview/

# macOS metadata
.DS_Store
._*
